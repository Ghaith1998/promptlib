# Copy to .env and fill in. Never commit .env.
MYSQL_ROOT_PASSWORD=change-me

# Application database user (schema: promptlib)
DB_USER=promptlib
DB_PASSWORD=change-me

# Keycloak database user (schema: keycloak)
KC_DB_USER=keycloak
KC_DB_PASSWORD=change-me

# Keycloak bootstrap admin (master realm)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me

# Confidential client secrets
KC_EDGE_SECRET=change-me
KC_REGISTER_CLIENT_SECRET=change-me

# Image tag deployed by compose
TAG=dev
